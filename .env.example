# Backend Environment Variables (Production)

# CORS Configuration - Add your production frontend domain(s)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=centralindia

# Soniox STT
SONIOX_API_KEY=your_soniox_api_key_here

# Sarvam STT Configuration
SARVAM_API_KEY=your_sarvam_api_key_here
# Valid BCP-47 language codes: hi-IN (Hindi), en-IN (English), bn-IN (Bengali), 
# gu-IN (Gujarati), kn-IN (Kannada), ml-IN (Malayalam), mr-IN (Marathi), 
# od-IN (Odia), pa-IN (Punjabi), ta-IN (Tamil), te-IN (Telugu)
SARVAM_STT_LANGUAGE=hi-IN

# Cube VoIP Configuration
CUBE_CLICK2CALL_URL=https://cubesoftservices.com/QuickCallRHICL/Click2Call.php
CUBE_CAMPAIGN_ID=Ailife_SIPBot_Jatin
CUBE_DID=08037367249

# Database (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
# Note: Use Service Role Key (not anon key) for backend operations

# Server Configuration
PORT=8000
HOST=0.0.0.0
